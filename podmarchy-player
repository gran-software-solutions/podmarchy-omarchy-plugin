#!/bin/bash

# Podmarchy: one mpv at a time, driven over its IPC socket.
#
#   play '<json>'     {id, feedId, title, show, image, url, start}
#   toggle            pause / resume
#   seek <seconds>    relative seek, negative goes back
#   stop              quit mpv; its status script saves the position first
#   status            print the current status JSON (repairs a stale one)
#
# mpv is started in its own session, so an episode keeps playing across shell
# restarts. podmarchy-status.lua inside mpv writes status.json every second
# and the listening progress on pause, every few seconds and on exit. The
# system mpv-mpris script, when installed, adds media keys for free.

set -o pipefail
umask 077

: "${XDG_RUNTIME_DIR:?Podmarchy requires XDG_RUNTIME_DIR}"
RUNTIME_DIR="$XDG_RUNTIME_DIR/podmarchy"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/podmarchy"
SOCKET="$RUNTIME_DIR/mpv.sock"
STATUS_FILE="$RUNTIME_DIR/status.json"
META_FILE="$RUNTIME_DIR/episode.json"
PID_FILE="$RUNTIME_DIR/mpv.pid"
LOG_FILE="$RUNTIME_DIR/mpv.log"
PROGRESS_FILE="$STATE_DIR/progress.json"
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

mkdir -p "$RUNTIME_DIR" "$STATE_DIR"

idle_status() {
  local tmp
  tmp=$(mktemp "$RUNTIME_DIR/status.XXXXXX")
  printf '{"running":false,"paused":false,"position":0,"duration":0,"episode":{}}\n' >"$tmp"
  mv "$tmp" "$STATUS_FILE"
}

# A pid file is trusted only while that pid is still an mpv process, so a
# recycled pid never gets a signal meant for the player.
player_pid() {
  local pid
  [[ -s $PID_FILE ]] || return 1
  read -r pid <"$PID_FILE" || return 1
  [[ $pid =~ ^[0-9]+$ ]] || return 1
  [[ $(cat "/proc/$pid/comm" 2>/dev/null) == mpv ]] || return 1
  printf '%s\n' "$pid"
}

ipc() {
  [[ -S $SOCKET ]] || return 1
  printf '%s\n' "$1" | socat -T 1 - "UNIX-CONNECT:$SOCKET" >/dev/null 2>&1
}

stop_player() {
  local pid
  pid=$(player_pid) || { rm -f "$PID_FILE" "$SOCKET"; return 0; }
  ipc '{"command":["quit"]}' || kill "$pid" 2>/dev/null
  for _ in $(seq 1 100); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.02
  done
  kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null
  rm -f "$PID_FILE" "$SOCKET"
}

case ${1:-} in
  play)
    meta=${2:-}
    jq -e '(.url | type == "string") and (.url | test("^https?://"; "i")) and (.url | test("[\\r\\n]") | not)' \
      <<<"$meta" >/dev/null 2>&1 || { echo "Not a playable episode" >&2; exit 2; }

    stop_player

    start=$(jq -r '(.start // 0) | tonumber? // 0 | floor | if . < 0 then 0 else . end' <<<"$meta")
    title=$(jq -r '(.title // "Podcast") | gsub("[\\r\\n]"; " ")' <<<"$meta")
    url=$(jq -r '.url' <<<"$meta")
    tmp=$(mktemp "$RUNTIME_DIR/episode.XXXXXX")
    jq -c '{id: (.id // "" | tostring), feedId: (.feedId // "" | tostring), title: (.title // ""),
            show: (.show // ""), image: (.image // ""), url: .url}' <<<"$meta" >"$tmp"
    mv "$tmp" "$META_FILE"

    PODMARCHY_STATUS_FILE="$STATUS_FILE" \
    PODMARCHY_META_FILE="$META_FILE" \
    PODMARCHY_PROGRESS_FILE="$PROGRESS_FILE" \
      setsid mpv --no-video --no-terminal --idle=no --really-quiet \
        --input-ipc-server="$SOCKET" \
        --force-media-title="$title" \
        --start="$start" \
        --cache=yes --demuxer-max-bytes=64MiB \
        --script="$script_dir/podmarchy-status.lua" \
        -- "$url" >"$LOG_FILE" 2>&1 </dev/null &
    printf '%s\n' "$!" >"$PID_FILE"
    disown
    ;;

  toggle)
    ipc '{"command":["cycle","pause"]}'
    ;;

  seek)
    [[ ${2:-} =~ ^-?[0-9]+$ ]] || exit 2
    ipc "{\"command\":[\"seek\",$2,\"relative\"]}"
    ;;

  stop)
    stop_player
    idle_status
    ;;

  status)
    if player_pid >/dev/null && [[ -s $STATUS_FILE ]]; then
      cat "$STATUS_FILE"
    else
      rm -f "$PID_FILE" "$SOCKET"
      idle_status
      cat "$STATUS_FILE"
    fi
    ;;

  *)
    echo "usage: podmarchy-player play|toggle|seek|stop|status" >&2
    exit 2
    ;;
esac
