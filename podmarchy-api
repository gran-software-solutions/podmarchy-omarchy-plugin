#!/bin/bash

# Podmarchy: Podcast Index client. Every command prints exactly one JSON
# document on stdout, and failures print {"error": "..."} and exit non-zero,
# so the shell never has to parse stderr.
#
#   auth-set            key and secret on stdin, one per line
#   auth-clear          forget the stored credentials
#   auth-status         {"configured": bool}
#   search <term>       shows matching a term
#   trending [lang]     trending shows, optionally for one language
#   episodes <feedId>   newest episodes of one show

set -o pipefail
umask 077

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/podmarchy"
CRED_FILE="$STATE_DIR/credentials.json"
API="${PODMARCHY_API_BASE:-https://api.podcastindex.org/api/1.0}"
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
version=$(jq -r '.version // "0"' "$script_dir/manifest.json" 2>/dev/null)
USER_AGENT="Podmarchy/$version (+https://github.com/gran-software-solutions/podmarchy-omarchy-plugin)"
MAX_RESPONSE_BYTES=$((8 * 1024 * 1024))

mkdir -p "$STATE_DIR"

fail() {
  jq -cn --arg e "$1" '{error: $e}'
  exit 1
}

# Podcast Index descriptions are HTML. The panel renders plain text, so tags go,
# block breaks become paragraph breaks and the common entities are decoded.
readonly PLAIN='def plain(limit):
  (. // "") | tostring
  | gsub("(?i)<br\\s*/?>|</p>|</li>|</h[1-6]>"; "\n")
  | gsub("<[^>]*>"; "")
  | gsub("&nbsp;"; " ") | gsub("&quot;"; "\"") | gsub("&#0?39;|&apos;|&rsquo;|&lsquo;"; "'\''")
  | gsub("&ldquo;|&rdquo;"; "\"") | gsub("&hellip;"; "…") | gsub("&mdash;"; "—") | gsub("&ndash;"; "–")
  | gsub("&lt;"; "<") | gsub("&gt;"; ">") | gsub("&amp;"; "&")
  | gsub("[ \t\r]+"; " ") | gsub(" *\n *"; "\n") | gsub("\n{3,}"; "\n\n")
  | ltrimstr(" ") | ltrimstr("\n") | rtrimstr("\n") | .[0:limit];
def line(limit): plain(limit) | gsub("\n+"; " ");'

readonly FEED='def feed: {
  id: (.id | tostring),
  title: (.title | line(300)),
  author: ((.author // .ownerName) | line(200)),
  image: ((.artwork // "") as $a | if $a != "" then $a else (.image // "") end),
  description: (.description | plain(3000)),
  url: (.url // ""),
  link: (.link // ""),
  language: (.language // ""),
  categories: ((.categories // {}) | [.[]] | join(", ")),
  episodeCount: (.episodeCount // 0),
  newest: (.newestItemPublishTime // .lastUpdateTime // 0)
};'

readonly EPISODE='def episode: {
  id: (.id | tostring),
  feedId: (.feedId | tostring),
  title: (.title | line(300)),
  description: (.description | plain(6000)),
  date: (.datePublished // 0),
  duration: (.duration // 0),
  url: (.enclosureUrl // ""),
  type: (.enclosureType // ""),
  link: (.link // ""),
  image: ((.image // "") as $i | if $i != "" then $i else (.feedImage // "") end),
  season: (.season // 0),
  number: (.episode // 0)
};'

load_credentials() {
  [[ -s $CRED_FILE ]] || fail "No Podcast Index key yet. Add one in settings (Ctrl+,)."
  api_key=$(jq -r '.key // empty' "$CRED_FILE")
  api_secret=$(jq -r '.secret // empty' "$CRED_FILE")
  [[ -n $api_key && -n $api_secret ]] || fail "The stored Podcast Index key is incomplete. Add it again in settings."
}

# GET an API path. Extra arguments are curl --data-urlencode pairs. The key and
# signature go in a header file rather than argv, so they never show up in ps.
call() {
  local path=$1
  shift
  load_credentials

  local now hash headers body code
  now=$(date +%s)
  hash=$(printf '%s%s%s' "$api_key" "$api_secret" "$now" | sha1sum | cut -d' ' -f1)
  headers=$(printf 'User-Agent: %s\nX-Auth-Key: %s\nX-Auth-Date: %s\nAuthorization: %s\n' \
    "$USER_AGENT" "$api_key" "$now" "$hash")

  local args=()
  for pair in "$@"; do args+=(--data-urlencode "$pair"); done

  body=$(curl -sS --get --max-time 20 --max-filesize "$MAX_RESPONSE_BYTES" \
    -H @<(printf '%s' "$headers") "${args[@]}" \
    -w '\n%{http_code}' "$API$path" 2>&1) || fail "Could not reach Podcast Index: ${body##*$'\n'}"

  code=${body##*$'\n'}
  body=${body%$'\n'*}

  case $code in
    200) printf '%s' "$body" ;;
    401) fail "Podcast Index rejected the key. Check it in settings (Ctrl+,)." ;;
    429) fail "Podcast Index is rate limiting requests. Try again in a minute." ;;
    *) fail "Podcast Index returned HTTP $code." ;;
  esac
}

case ${1:-} in
  auth-set)
    IFS= read -r key || true
    IFS= read -r secret || true
    key=$(tr -d '[:space:]' <<<"$key")
    secret=$(tr -d '[:space:]' <<<"$secret")
    [[ $key =~ ^[A-Za-z0-9]{8,64}$ ]] || fail "That does not look like a Podcast Index API key."
    [[ $secret =~ ^[[:graph:]]{8,128}$ ]] || fail "That does not look like a Podcast Index API secret."
    tmp=$(mktemp "$STATE_DIR/credentials.XXXXXX")
    jq -n --arg key "$key" --arg secret "$secret" '{key: $key, secret: $secret}' >"$tmp"
    mv "$tmp" "$CRED_FILE"
    echo '{"ok":true}'
    ;;

  auth-clear)
    rm -f "$CRED_FILE"
    echo '{"ok":true}'
    ;;

  auth-status)
    if [[ -s $CRED_FILE ]]; then echo '{"configured":true}'; else echo '{"configured":false}'; fi
    ;;

  search)
    term=${2:-}
    [[ -n ${term// /} ]] || fail "Type something to search for."
    json=$(call /search/byterm "q=$term" "max=40") || { printf '%s\n' "$json"; exit 1; }
    jq -c "$PLAIN $FEED"'{feeds: [(.feeds // [])[] | feed]}' <<<"$json" || fail "Podcast Index sent a response Podmarchy could not read."
    ;;

  trending)
    lang=${2:-}
    params=("max=40")
    [[ $lang =~ ^[A-Za-z,-]{2,40}$ ]] && params+=("lang=$lang")
    json=$(call /podcasts/trending "${params[@]}") || { printf '%s\n' "$json"; exit 1; }
    jq -c "$PLAIN $FEED"'{feeds: [(.feeds // [])[] | feed]}' <<<"$json" || fail "Podcast Index sent a response Podmarchy could not read."
    ;;

  episodes)
    feed=${2:-}
    [[ $feed =~ ^[0-9]+$ ]] || fail "Not a feed id: $feed"
    json=$(call /episodes/byfeedid "id=$feed" "max=100") || { printf '%s\n' "$json"; exit 1; }
    jq -c "$PLAIN $EPISODE"'{feedId: "'"$feed"'", items: [(.items // [])[] | episode | select(.url | test("^https?://"; "i"))]}' <<<"$json" \
      || fail "Podcast Index sent a response Podmarchy could not read."
    ;;

  *)
    fail "Unknown command: ${1:-}"
    ;;
esac
